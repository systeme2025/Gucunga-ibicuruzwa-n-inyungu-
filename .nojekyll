/* ============================================================
   15. CSV + JSON EXPORT
   ============================================================ */
function csvEscape(v) {
  if (v === null || v === undefined) return "";
  const s = String(v).replace(/"/g, '""');
  return /[",\n]/.test(s) ? `"${s}"` : s;
}

function exportCsv() {
  const rows = state.responses.map(r => {
    const s1 = r.shopProfile || r.answers?.section1 || {};
    const s14 = r.answers?.section14 || {};
    return {
      responseId: r.meta?.responseId || r._key,
      interviewDate: r.meta?.interviewDate || "",
      shopName: s1.shopName || "", ownerName: s1.ownerName || "", ownerPhone: s1.ownerPhone || "",
      district: s1.district || "", sector: s1.sector || "", shopType: s1.shopType || "",
      employeeCount: s1.employeeCount || "", budget: s14.budget || "", timeline: s14.timeline || "",
      status: r.meta?.status || "new", samplesCount: (r.samples || []).length,
    };
  });
  if (!rows.length) { toast("Nta bisubizo byo kohereza", "warn"); return; }
  const headers = Object.keys(rows[0]);
  const csv = [headers.join(","), ...rows.map(row => headers.map(h => csvEscape(row[h])).join(","))].join("\n");
  const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url; a.download = `MAYE-Interviews-${new Date().toISOString().slice(0, 10)}.csv`;
  a.click(); URL.revokeObjectURL(url);
  toast("CSV yabitswe", "success");
}

function downloadAllResponsesJson() {
  if (!state.responses.length) { toast("Nta bisubizo", "warn"); return; }
  const blob = new Blob([JSON.stringify(state.responses, null, 2)], { type: "application/json" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url; a.download = `MAYE-All-Responses-${new Date().toISOString().slice(0, 10)}.json`;
  a.click(); URL.revokeObjectURL(url);
  toast("JSON yose yabitswe", "success");
}

function downloadResponseJson(r) {
  const blob = new Blob([JSON.stringify(r, null, 2)], { type: "application/json" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url; a.download = `MAYE-Response-${r.meta?.responseId || r._key}.json`;
  a.click(); URL.revokeObjectURL(url);
  toast("JSON yabitswe", "success");
}

document.getElementById("btnExportCsv").addEventListener("click", exportCsv);
document.getElementById("btnExportAllJson").addEventListener("click", downloadAllResponsesJson);
document.getElementById("btnRefreshList").addEventListener("click", loadResponses);

/* ============================================================
   16. PDF GENERATION (html2pdf)
   ============================================================ */

// Escape HTML for PDF
function esc(s) {
  if (s === null || s === undefined) return "—";
  return String(s).replace(/[&<>"']/g, c => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c]));
}

function formatDate(ts) {
  if (!ts) return "—";
  return new Date(ts).toLocaleString("en-GB", { year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" });
}

function statusBadge(status) {
  const map = {
    new: { cls: "pdf-badge-new", label: "NEW" },
    reviewed: { cls: "pdf-badge-reviewed", label: "REVIEWED" },
    blueprint_ready: { cls: "pdf-badge-ready", label: "BLUEPRINT READY" },
  };
  const m = map[status] || map.new;
  return `<span class="pdf-badge ${m.cls}">${m.label}</span>`;
}

function buildResponsePdfHtml(r) {
  const s1 = r.shopProfile || r.answers?.section1 || {};
  const meta = r.meta || {};
  const da = r.developerAnalysis || {};
  const sections = [];

  // Cover page
  sections.push(`
    <div class="pdf-cover" style="page-break-after: always;">
      <img src="${LOGO_URL}" alt="MAYE" />
      <div class="pdf-title">MAYE Shop Interview</div>
      <div class="pdf-subtitle">Response Report</div>
      <div class="pdf-meta"><strong>${esc(s1.shopName || "Izina ritazwi")}</strong></div>
      <div class="pdf-meta">${esc(s1.ownerName || "—")} • ${esc(s1.ownerPhone || "—")}</div>
      <div class="pdf-meta">${esc(s1.district || "—")} • ${esc(s1.shopType || "—")}</div>
      <div class="pdf-ref">${esc(meta.responseId || "—")}</div>
      <div class="pdf-meta" style="margin-top: 8mm;">${statusBadge(meta.status)} ${meta.approvedByDeveloper ? '<span class="pdf-badge pdf-badge-ready">✓ APPROVED</span>' : ''}</div>
      <div class="pdf-meta" style="margin-top: 4mm;">Interview Date: ${esc(meta.interviewDate || "—")}</div>
      <div class="pdf-meta">Generated: ${formatDate(Date.now())}</div>
      <div class="pdf-footer" style="margin-top: auto; padding-top: 20mm;">
        Powered by MAYE SYSTEM • MAYE-SIAP v${APP_VERSION}
      </div>
    </div>
  `);

  // Shop profile
  sections.push(`
    <h2>Shop Profile</h2>
    <div class="pdf-row">
      <div class="pdf-col"><div class="pdf-label">Shop Name</div><div class="pdf-value">${esc(s1.shopName)}</div></div>
      <div class="pdf-col"><div class="pdf-label">Owner</div><div class="pdf-value">${esc(s1.ownerName)}</div></div>
    </div>
    <div class="pdf-row">
      <div class="pdf-col"><div class="pdf-label">Phone</div><div class="pdf-value">${esc(s1.ownerPhone)}</div></div>
      <div class="pdf-col"><div class="pdf-label">District</div><div class="pdf-value">${esc(s1.district)}</div></div>
    </div>
    <div class="pdf-row">
      <div class="pdf-col"><div class="pdf-label">Sector</div><div class="pdf-value">${esc(s1.sector)}</div></div>
      <div class="pdf-col"><div class="pdf-label">Shop Type</div><div class="pdf-value">${esc(s1.shopType)}</div></div>
    </div>
    <div class="pdf-row">
      <div class="pdf-col"><div class="pdf-label">Employees</div><div class="pdf-value">${esc(s1.employeeCount)}</div></div>
      <div class="pdf-col"><div class="pdf-label">Year Opened</div><div class="pdf-value">${esc(s1.yearOpened)}</div></div>
    </div>
    <div class="pdf-row">
      <div class="pdf-col"><div class="pdf-label">Electricity</div><div class="pdf-value">${esc(s1.hasElectricity)}</div></div>
      <div class="pdf-col"><div class="pdf-label">Internet</div><div class="pdf-value">${esc(s1.hasInternet)}</div></div>
    </div>
  `);

  // Each section (1 page break between big sections)
  SECTIONS.forEach((sec, idx) => {
    const a = r.answers?.[sec.id] || {};
    const obs = r.observations?.[sec.id];
    const rows = [];
    sec.fields.forEach(f => {
      if (!f.label || f.type === "samples" || f.type === "employees" || f.type === "note") return;
      const v = a[f.key];
      if (v === undefined || v === null || v === "" || (Array.isArray(v) && !v.length)) return;
      rows.push(`
        <div class="pdf-row">
          <div class="pdf-col" style="flex: 0 0 40mm;"><div class="pdf-label">${esc(f.label)}</div></div>
          <div class="pdf-col"><div class="pdf-value">${esc(Array.isArray(v) ? v.join(", ") : v)}</div></div>
        </div>
      `);
    });
    if (sec.id === "section3" && r.samples?.length) {
      r.samples.forEach((s, i) => {
        if (!s.name) return;
        rows.push(`
          <div class="pdf-card">
            <div class="pdf-label">Sample #${i + 1}: ${esc(s.name)}</div>
            <div class="pdf-value">${esc(s.size || "—")} • ${esc(s.purchaseUnit)} → ${esc(s.sellingUnit)} (${esc(s.conversionFactor || "—")})</div>
            <div class="pdf-value">Buy: ${esc(s.purchasePrice)} ${esc(s.purchaseCurrency)} | Sell: ${esc(s.sellingPrice)} ${esc(s.sellingCurrency)} | Stock: ${esc(s.currentStock)}</div>
            <div class="pdf-value">Supplier: ${esc(s.supplierName || "—")} | Expires: ${s.expires ? "Yes" : "No"} | Damages: ${s.damagesEasily ? "Yes" : "No"}</div>
            ${s.notes ? `<div class="pdf-value" style="font-style: italic;">${esc(s.notes)}</div>` : ""}
          </div>
        `);
      });
    }
    if (!rows.length) return;
    sections.push(`
      <h2 style="page-break-before: auto;">${idx + 1}. ${esc(sec.title)}</h2>
      ${rows.join("")}
      ${obs ? `<div class="pdf-card" style="border-left-color: #d4af37; background: #fffbf0;">
        <div class="pdf-label" style="color: #d4af37;">👁 Observation (interviewer)</div>
        <div class="pdf-value">${esc(obs)}</div>
      </div>` : ""}
    `);
  });

  // Developer analysis
  if (da.analysisNotes || da.approved) {
    sections.push(`
      <h2 style="page-break-before: always;">Developer Analysis</h2>
      ${da.reviewedBy ? `<div class="pdf-value"><strong>Reviewed by:</strong> ${esc(da.reviewedBy)}</div>` : ""}
      ${da.reviewedAt ? `<div class="pdf-value"><strong>Reviewed at:</strong> ${formatDate(da.reviewedAt)}</div>` : ""}
      ${da.complexity ? `<div class="pdf-value"><strong>Complexity:</strong> ${esc(da.complexity.toUpperCase())}</div>` : ""}
      ${da.approved ? `<div class="pdf-value"><strong>Approved:</strong> ✓ Yes</div>` : ""}
      ${da.analysisNotes ? `<div class="pdf-card"><div class="pdf-label">Notes</div><div class="pdf-value">${esc(da.analysisNotes)}</div></div>` : ""}
    `);
  }

  return `
    <div class="pdf-doc">
      ${sections.join("")}
      <div class="pdf-footer">
        MAYE-SIAP v${APP_VERSION} • Generated ${formatDate(Date.now())} • Response ${esc(meta.responseId || "—")}
      </div>
    </div>
  `;
}

function buildBlueprintPdfHtml(bp) {
  const s = bp.shopProfile || {};
  const summary = bp.interviewSummary || {};

  const modulesHtml = (bp.detectedModules || []).map(m => `
    <div class="pdf-card">
      <div class="pdf-label">${esc(m.moduleId)} — ${esc(m.priority)} priority</div>
      <div class="pdf-value">${esc(m.rationale)}</div>
      <div class="pdf-value"><strong>Entities:</strong> ${esc((m.entities || []).join(", "))}</div>
      <div class="pdf-value"><strong>Workflows:</strong> ${esc((m.workflows || []).join(", "))}</div>
      <div class="pdf-value"><strong>Complexity:</strong> ${esc(m.estimatedComplexity)}</div>
    </div>
  `).join("");

  const entitiesHtml = (bp.detectedEntities || []).map(e => `
    <div class="pdf-value"><strong>${esc(e.name)}:</strong> ${esc((e.fields || []).join(", "))}</div>
  `).join("");

  const workflowsHtml = (bp.detectedWorkflows || []).map(w => `<div class="pdf-value">• ${esc(w)}</div>`).join("");
  const rulesHtml = (bp.businessRules || []).map(r => `<div class="pdf-value">• ${esc(r)}</div>`).join("");

  const sampleTxHtml = (bp.sampleTransactions || []).map(tx => `
    <div class="pdf-card">
      <div class="pdf-value"><strong>${esc(tx.description)}</strong></div>
      <div class="pdf-value">Revenue: ${esc(tx.totalRevenue)} | Cost: ${esc(tx.totalCost)} | Profit: ${esc(tx.profit)} (${esc(tx.profitMargin)}%)</div>
    </div>
  `).join("");

  const testsHtml = (bp.acceptanceTests || []).map(t => `<div class="pdf-value">☐ ${esc(t)}</div>`).join("");

  return `
    <div class="pdf-doc">
      <div class="pdf-cover" style="page-break-after: always;">
        <img src="${LOGO_URL}" alt="MAYE" />
        <div class="pdf-title">Development Blueprint</div>
        <div class="pdf-subtitle">Inventory Management System</div>
        <div class="pdf-meta"><strong>${esc(summary.shopName || s.shopName || "—")}</strong></div>
        <div class="pdf-meta">${esc(summary.ownerName || s.ownerName || "—")} • ${esc(summary.district || s.district || "—")}</div>
        <div class="pdf-ref">${esc(bp.blueprintId || "BP-XXXXX")}</div>
        <div class="pdf-meta" style="margin-top: 4mm;">Source: ${esc((bp.sourceResponseIds || []).join(", "))}</div>
        <div class="pdf-meta">Generated: ${formatDate(bp.generatedAt)}</div>
        <div class="pdf-footer" style="margin-top: auto; padding-top: 20mm;">
          Powered by MAYE SYSTEM • MAYE-SIAP v${APP_VERSION}
        </div>
      </div>

      <h2>Interview Summary</h2>
      <div class="pdf-row">
        <div class="pdf-col"><div class="pdf-label">Shop</div><div class="pdf-value">${esc(summary.shopName)}</div></div>
        <div class="pdf-col"><div class="pdf-label">Owner</div><div class="pdf-value">${esc(summary.ownerName)}</div></div>
      </div>
      <div class="pdf-row">
        <div class="pdf-col"><div class="pdf-label">District</div><div class="pdf-value">${esc(summary.district)}</div></div>
        <div class="pdf-col"><div class="pdf-label">Shop Type</div><div class="pdf-value">${esc(summary.shopType)}</div></div>
      </div>
      <div class="pdf-row">
        <div class="pdf-col"><div class="pdf-label">Employees</div><div class="pdf-value">${esc(summary.employeeCount)}</div></div>
        <div class="pdf-col"><div class="pdf-label">Budget</div><div class="pdf-value">${esc(summary.budget)}</div></div>
      </div>
      <div class="pdf-row">
        <div class="pdf-col"><div class="pdf-label">Timeline</div><div class="pdf-value">${esc(summary.timeline)}</div></div>
        <div class="pdf-col"><div class="pdf-label">Smartphone</div><div class="pdf-value">${summary.hasSmartphone ? "Yes" : "No"}</div></div>
      </div>
      <div class="pdf-row">
        <div class="pdf-col"><div class="pdf-label">Internet</div><div class="pdf-value">${esc(summary.internetQuality)}</div></div>
      </div>

      <h2 style="page-break-before: always;">Detected Modules</h2>
      ${modulesHtml}

      <h2 style="page-break-before: always;">Detected Entities</h2>
      ${entitiesHtml}

      <h2>Detected Workflows</h2>
      ${workflowsHtml}

      <h2>Business Rules</h2>
      ${rulesHtml}

      <h2 style="page-break-before: always;">Sample Transactions</h2>
      ${sampleTxHtml}

      <h2>Acceptance Tests</h2>
      ${testsHtml}

      <div class="pdf-footer">
        MAYE-SIAP v${APP_VERSION} • Blueprint ${esc(bp.blueprintId || "—")} • Generated ${formatDate(bp.generatedAt)}
      </div>
    </div>
  `;
}

async function generatePdfFromHtml(html, filename) {
  const container = document.createElement("div");
  container.style.position = "fixed";
  container.style.left = "-9999px";
  container.style.top = "0";
  container.innerHTML = html;
  document.body.appendChild(container);

  try {
    toast("⏳ Turakora PDF...", "warn");
    await html2pdf().set({
      margin: 0,
      filename,
      image: { type: "jpeg", quality: 0.98 },
      html2canvas: { scale: 2, useCORS: true, logging: false, backgroundColor: "#ffffff" },
      jsPDF: { unit: "mm", format: "a4", orientation: "portrait" },
      pagebreak: { mode: ["avoid-all", "css", "legacy"] },
    }).from(container.firstElementChild).save();
    toast("PDF yabitswe", "success");
  } catch (err) {
    console.error(err);
    toast("PDF ntiyakunze — gerageza Print", "error");
  } finally {
    document.body.removeChild(container);
  }
}

function downloadResponsePdf(r) {
  const html = buildResponsePdfHtml(r);
  const filename = `MAYE-Response-${r.meta?.responseId || r._key}-${Date.now()}.pdf`;
  generatePdfFromHtml(html, filename);
}

function generateBlueprintPdf(bp) {
  const html = buildBlueprintPdfHtml(bp);
  const filename = `MAYE-Blueprint-${bp.blueprintId || "BP"}-${Date.now()}.pdf`;
  generatePdfFromHtml(html, filename);
}

/* ============================================================
   17. ADMIN ACCESS FLOW
   ============================================================ */
async function checkAdminAccess() {
  if (!state.uid) {
    setAdminGateMsg("Nta UID — Anonymous Auth iracyakora. Tegereza.", "warn");
    return false;
  }
  try {
    const snap = await get(ref(db, `systemSettings/interviewFlags/adminAllowList/${state.uid}`));
    if (snap.exists() && snap.val() === true) {
      state.isAdmin = true;
      return true;
    }
    setAdminGateMsg("UID yawe ntabwo iri muri adminAllowList. Kurikiza amabwiriza hejuru.", "error");
    return false;
  } catch (err) {
    console.error(err);
    setAdminGateMsg("Ntibyakunze kugenzura access. Reba amabwiriza ya database.rules.json.", "error");
    return false;
  }
}

function setAdminGateMsg(text, type) {
  const el = document.getElementById("adminGateMsg");
  el.textContent = text;
  el.className = "mt-4 text-sm font-semibold rounded-maye-md px-4 py-2.5 " + (
    type === "error" ? "bg-maye-danger/10 text-maye-danger border border-maye-danger/30"
    : type === "warn" ? "bg-maye-warning/10 text-maye-warning border border-maye-warning/30"
    : "bg-maye-success/10 text-maye-success border border-maye-success/30"
  );
  el.classList.remove("hidden");
}

document.getElementById("btnToggleUid").addEventListener("click", () => {
  state.uidVisible = !state.uidVisible;
  const uidEl = document.getElementById("adminUid");
  const btn = document.getElementById("btnToggleUid");
  if (state.uidVisible) {
    uidEl.classList.remove("blur-sm", "select-none");
    btn.textContent = "🙈 Hisha UID";
  } else {
    uidEl.classList.add("blur-sm", "select-none");
    btn.textContent = "👁 Erekana UID";
  }
});

document.getElementById("btnAdminAccess").addEventListener("click", async () => {
  const uidEl = document.getElementById("adminUid");
  uidEl.textContent = state.uid || "—";
  uidEl.classList.add("blur-sm", "select-none");
  state.uidVisible = false;
  document.getElementById("btnToggleUid").textContent = "👁 Erekana UID";
  document.getElementById("adminGateMsg").classList.add("hidden");
  showScreen("screenAdminGate");
  const ok = await checkAdminAccess();
  if (ok) { showScreen("screenDashboard"); loadResponses(); }
});

document.getElementById("btnAdminRetry").addEventListener("click", async () => {
  const ok = await checkAdminAccess();
  if (ok) { showScreen("screenDashboard"); loadResponses(); }
});

document.getElementById("btnAdminCancel").addEventListener("click", () => {
  showScreen("screenWelcome");
});

/* ============================================================
   18. HELP MODAL
   ============================================================ */
function openHelp() {
  document.getElementById("helpModal").classList.remove("hidden");
  document.getElementById("helpModal").classList.add("flex");
}
function closeHelp() {
  document.getElementById("helpModal").classList.add("hidden");
  document.getElementById("helpModal").classList.remove("flex");
}
document.getElementById("btnHelp")?.addEventListener("click", openHelp);
document.getElementById("btnShowHelp")?.addEventListener("click", openHelp);
document.getElementById("btnCloseHelp")?.addEventListener("click", closeHelp);
document.getElementById("btnCloseHelp2")?.addEventListener("click", closeHelp);

/* ============================================================
   19. NAVIGATION
   ============================================================ */
document.getElementById("btnStartInterview").addEventListener("click", () => {
  state.currentSection = 0;
  state.answers = {};
  state.observations = {};
  state.samples = [newSample()];
  showScreen("screenInterview");
  renderSection();
});

document.getElementById("btnResumeDraft").addEventListener("click", async () => {
  const d = await loadDraft();
  if (!d) { toast("Nta draft ibonetse", "warn"); return; }
  state.currentSection = d.currentSection || 0;
  state.answers = d.answers || {};
  state.observations = d.observations || {};
  state.samples = d.samples && d.samples.length ? d.samples : [newSample()];
  showScreen("screenInterview");
  renderSection();
});

document.getElementById("btnPrevSection").addEventListener("click", () => {
  if (state.currentSection > 0) { state.currentSection--; renderSection(); }
});

document.getElementById("btnNextSection").addEventListener("click", () => {
  const missing = validateSection(state.currentSection);
  if (missing.length) { toast("Bura ibisubizo: " + missing.slice(0, 3).join(", "), "error"); return; }
  if (state.currentSection < TOTAL_SECTIONS - 1) {
    state.currentSection++; renderSection();
  } else {
    renderReview(); showScreen("screenReview");
  }
});

document.getElementById("btnBackToEdit").addEventListener("click", () => {
  state.currentSection = 0;
  showScreen("screenInterview");
  renderSection();
});

document.getElementById("btnSubmit").addEventListener("click", submitInterview);

document.getElementById("btnNewInterview").addEventListener("click", () => {
  state.currentSection = 0;
  state.answers = {};
  state.observations = {};
  state.samples = [newSample()];
  showScreen("screenWelcome");
});

document.getElementById("btnBackToList").addEventListener("click", () => {
  showScreen("screenDashboard");
  loadResponses();
});

/* ============================================================
   20. ONLINE / OFFLINE
   ============================================================ */
window.addEventListener("online", () => { state.online = true; updateConnBadge(); syncPending(); });
window.addEventListener("offline", () => { state.online = false; updateConnBadge(); });

function updateConnBadge() {
  const b = document.getElementById("connBadge");
  if (!b) return;
  if (state.online) b.innerHTML = `<span class="w-2 h-2 rounded-full bg-maye-success"></span> Online`;
  else b.innerHTML = `<span class="w-2 h-2 rounded-full bg-maye-danger"></span> Offline`;
}

/* ============================================================
   21. ANONYMOUS AUTH + BOOT
   ============================================================ */
onAuthStateChanged(auth, async (user) => {
  if (user) {
    state.uid = user.uid;
    console.log("[MAYE] Anonymous UID:", user.uid);
    updateConnBadge();
    await checkForDraftAndPending();
  } else {
    try {
      await signInAnonymously(auth);
    } catch (err) {
      console.error("Anonymous auth failed:", err);
      document.getElementById("loadingError").textContent =
        "Anonymous Auth ntikora. Reba ko Anonymous Auth yemewe muri Firebase Console → Authentication → Sign-in method.";
      document.getElementById("loadingError").classList.remove("hidden");
    }
  }
});

async function checkForDraftAndPending() {
  document.getElementById("screenLoading").classList.remove("active", "flex-active");
  const d = await loadDraft();
  if (d && d.savedAt) document.getElementById("btnResumeDraft").classList.remove("hidden");
  await syncPending();
  showScreen("screenWelcome");

  // Show Admin Access button ONLY if URL has ?admin=1
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get("admin") === "1") {
    document.getElementById("btnAdminAccess").classList.remove("hidden");
  }
}

/* ============================================================
   22. SERVICE WORKER
   ============================================================ */
if ("serviceWorker" in navigator) {
  window.addEventListener("load", () => {
    navigator.serviceWorker.register("./sw.js")
      .then(reg => console.log("[MAYE] SW registered:", reg.scope))
      .catch(err => console.warn("[MAYE] SW registration failed:", err));
  });
}

/* ============================================================
   23. FALLBACK
   ============================================================ */
setTimeout(() => {
  if (state.screen === "screenLoading" && !state.uid) {
    document.getElementById("loadingError").textContent =
      "Anonymous Auth iracyatinda. Reba internet cyangwa Firebase Console → Authentication.";
    document.getElementById("loadingError").classList.remove("hidden");
  }
}, 8000);
</script>
</body>
</html>
