      { key: "internetQuality", label: "Internet ni gute?", type: "radio", required: true,
        options: ["good","fair","poor","none"] },
      { key: "ownerTechSavvy", label: "Nyir'iduka azi gukoresha smartphone?", type: "radio", required: true,
        options: ["comfortable","some","not at all"] },
      { key: "budget", label: "Budget (RWF)", type: "radio", required: true,
        options: ["0","<100k","100k-500k","500k-2M","2M-5M",">5M"] },
      { key: "timeline", label: "Timeline", type: "radio", required: true,
        options: ["<2 weeks","1 month","2-3 months","6 months","no rush"] },
      { key: "wantsMomoBankIntegration", label: "Mwishaka gukorana na MoMo / Bank?", type: "radio", required: true, options: ["yego","oya"] },
      { key: "anythingElse", label: "Ikindi mwishaka kutubwira", type: "textarea", required: false },
    ],
  },
];

/* ============================================================
   5. FIELD RENDERERS
   ============================================================ */
function el(tag, attrs = {}, children = []) {
  const e = document.createElement(tag);
  Object.entries(attrs).forEach(([k, v]) => {
    if (k === "class") e.className = v;
    else if (k === "text") e.textContent = v;
    else if (k === "html") e.innerHTML = v;
    else if (k.startsWith("on") && typeof v === "function") e.addEventListener(k.slice(2).toLowerCase(), v);
    else e.setAttribute(k, v);
  });
  (Array.isArray(children) ? children : [children]).forEach(c => {
    if (c == null) return;
    e.appendChild(typeof c === "string" ? document.createTextNode(c) : c);
  });
  return e;
}

const inputClass = "w-full bg-white border border-maye-border rounded-maye-md px-3.5 py-2.5 text-sm text-maye-text-base focus:outline-none focus:ring-2 focus:ring-maye-accent focus:border-maye-primary-400 transition";
const labelClass = "block text-sm font-semibold text-maye-text-strong mb-1.5";
const radioWrap = "flex flex-wrap gap-2";
const radioPill = (active) =>
  `cursor-pointer select-none px-3.5 py-2 rounded-maye-sm border text-sm font-medium transition ` +
  (active
    ? "bg-maye-primary text-white border-maye-primary shadow-maye-sm"
    : "bg-white text-maye-text-base border-maye-border hover:border-maye-primary-400");

function renderField(field, value, onChange) {
  const wrap = el("div");

  if (field.type === "note") {
    wrap.appendChild(el("p", { class: "text-sm text-maye-text-muted bg-maye-muted border border-maye-border rounded-maye-md px-4 py-3", text: "📝 " + field.note }));
    return wrap;
  }

  const labelText = field.label + (field.required ? " *" : "");
  if (field.label) wrap.appendChild(el("label", { class: labelClass, text: labelText }));

  if (field.type === "text" || field.type === "tel" || field.type === "number") {
    const inp = el("input", { type: field.type, class: inputClass, placeholder: field.placeholder || "", value: value ?? "" });
    if (field.min !== undefined) inp.min = field.min;
    if (field.max !== undefined) inp.max = field.max;
    inp.addEventListener("input", () => onChange(field.type === "number" && inp.value !== "" ? Number(inp.value) : inp.value));
    wrap.appendChild(inp);
  } else if (field.type === "textarea") {
    const ta = el("textarea", { class: inputClass, rows: 3, placeholder: field.placeholder || "" });
    ta.value = value ?? "";
    ta.addEventListener("input", () => onChange(ta.value));
    wrap.appendChild(ta);
  } else if (field.type === "select") {
    const sel = el("select", { class: inputClass });
    sel.appendChild(el("option", { value: "", text: "— Hitamo —" }));
    field.options.forEach(opt => {
      const o = el("option", { value: opt, text: opt });
      if (value === opt) o.selected = true;
      sel.appendChild(o);
    });
    sel.addEventListener("change", () => onChange(sel.value));
    wrap.appendChild(sel);
  } else if (field.type === "radio") {
    const container = el("div", { class: radioWrap });
    field.options.forEach(opt => {
      const active = value === opt;
      const pill = el("button", {
        type: "button", class: radioPill(active), text: opt,
        onclick: () => { onChange(opt); renderSection(); },
      });
      container.appendChild(pill);
    });
    wrap.appendChild(container);
  } else if (field.type === "checkbox") {
    const container = el("div", { class: radioWrap });
    const arr = Array.isArray(value) ? [...value] : [];
    field.options.forEach(opt => {
      const active = arr.includes(opt);
      const pill = el("button", {
        type: "button", class: radioPill(active), text: opt,
        onclick: () => {
          const i = arr.indexOf(opt);
          if (i >= 0) arr.splice(i, 1); else arr.push(opt);
          onChange([...arr]);
          renderSection();
        },
      });
      container.appendChild(pill);
    });
    wrap.appendChild(container);
  } else if (field.type === "samples") {
    wrap.appendChild(renderSamplesEditor());
  } else if (field.type === "employees") {
    wrap.appendChild(renderEmployeesEditor());
  }

  return wrap;
}

function renderSamplesEditor() {
  const wrap = el("div", { class: "space-y-3" });
  if (state.samples.length === 0) state.samples.push(newSample());

  state.samples.forEach((s, idx) => {
    const card = el("div", { class: "bg-maye-muted/70 border border-maye-border rounded-maye-md p-4 space-y-3" });
    const header = el("div", { class: "flex items-center justify-between" });
    header.appendChild(el("div", { class: "text-sm font-bold text-maye-primary-600", text: `📦 Sample #${idx + 1}` }));
    if (state.samples.length > 1) {
      header.appendChild(el("button", {
        type: "button", class: "text-xs font-semibold text-maye-danger hover:underline", text: "🗑 Kuraho",
        onclick: () => { state.samples.splice(idx, 1); saveDraft(); renderSection(); },
      }));
    }
    card.appendChild(header);

    const grid = el("div", { class: "grid grid-cols-1 sm:grid-cols-2 gap-3" });
    const fields = [
      { key: "name", label: "Izina ry'agace", type: "text" },
      { key: "size", label: "Size / Variant", type: "text" },
      { key: "purchaseUnit", label: "Purchase Unit", type: "text", placeholder: "Carton, Sack, Bundle, Kg" },
      { key: "sellingUnit", label: "Selling Unit", type: "text", placeholder: "Kg, Piece, Meter" },
      { key: "conversionFactor", label: "Conversion Factor", type: "number", placeholder: "1 carton = ? kg" },
      { key: "purchasePrice", label: "Purchase Price", type: "number" },
      { key: "purchaseCurrency", label: "Currency (Purchase)", type: "select", options: ["RWF","AED"] },
      { key: "sellingPrice", label: "Selling Price", type: "number" },
      { key: "sellingCurrency", label: "Currency (Selling)", type: "select", options: ["RWF","AED"] },
      { key: "currentStock", label: "Current Stock", type: "number" },
      { key: "supplierName", label: "Supplier Name", type: "text" },
    ];
    fields.forEach(f => {
      const fw = el("div");
      fw.appendChild(el("label", { class: "block text-xs font-semibold text-maye-text-muted mb-1", text: f.label }));
      if (f.type === "select") {
        const sel = el("select", { class: inputClass });
        f.options.forEach(o => {
          const opt = el("option", { value: o, text: o });
          if ((s[f.key] || "RWF") === o) opt.selected = true;
          sel.appendChild(opt);
        });
        sel.addEventListener("change", () => { s[f.key] = sel.value; saveDraft(); });
        fw.appendChild(sel);
      } else {
        const inp = el("input", { type: f.type, class: inputClass, placeholder: f.placeholder || "", value: s[f.key] ?? "" });
        inp.addEventListener("input", () => {
          s[f.key] = f.type === "number" && inp.value !== "" ? Number(inp.value) : inp.value;
          saveDraft();
        });
        fw.appendChild(inp);
      }
      grid.appendChild(fw);
    });
    card.appendChild(grid);

    const yesNo = el("div", { class: "flex flex-wrap gap-4 pt-1" });
    ["expires", "damagesEasily"].forEach(k => {
      const label = k === "expires" ? "Irimo gupfa?" : "Ryangirika vuba?";
      const row = el("div", { class: "flex items-center gap-2" });
      row.appendChild(el("span", { class: "text-xs font-semibold text-maye-text-muted", text: label }));
      ["yego","oya"].forEach(v => {
        const active = (s[k] ? "yego" : "oya") === v;
        row.appendChild(el("button", {
          type: "button", class: radioPill(active) + " !px-2.5 !py-1 !text-xs", text: v,
          onclick: () => { s[k] = (v === "yego"); saveDraft(); renderSection(); },
        }));
      });
      yesNo.appendChild(row);
    });
    card.appendChild(yesNo);

    const notesWrap = el("div");
    notesWrap.appendChild(el("label", { class: "block text-xs font-semibold text-maye-text-muted mb-1", text: "Notes" }));
    const notes = el("textarea", { class: inputClass, rows: 2 });
    notes.value = s.notes || "";
    notes.addEventListener("input", () => { s.notes = notes.value; saveDraft(); });
    notesWrap.appendChild(notes);
    card.appendChild(notesWrap);

    wrap.appendChild(card);
  });

  if (state.samples.length < 5) {
    wrap.appendChild(el("button", {
      type: "button",
      class: "w-full px-4 py-2.5 rounded-maye-md border-2 border-dashed border-maye-border-strong text-sm font-semibold text-maye-primary-400 hover:bg-maye-muted transition",
      text: "+ Ongeraho sample",
      onclick: () => { state.samples.push(newSample()); saveDraft(); renderSection(); },
    }));
  }
  return wrap;
}

function newSample() {
  return {
    sampleId: "SMP-" + Math.random().toString(36).slice(2, 7).toUpperCase(),
    name: "", size: "", purchaseUnit: "", sellingUnit: "",
    conversionFactor: null, purchasePrice: null, purchaseCurrency: "RWF",
    sellingPrice: null, sellingCurrency: "RWF", currentStock: null,
    supplierName: "", expires: false, damagesEasily: false, notes: "",
  };
}

function renderEmployeesEditor() {
  const wrap = el("div", { class: "space-y-2" });
  const current = state.answers["section12"]?._employees || [];
  const rows = current.length ? current : [{ name: "", role: "" }];
  rows.forEach((emp, idx) => {
    const row = el("div", { class: "grid grid-cols-1 sm:grid-cols-2 gap-2" });
    const nameI = el("input", { type: "text", class: inputClass, placeholder: "Izina", value: emp.name || "" });
    const roleI = el("input", { type: "text", class: inputClass, placeholder: "Role (cashier, stock, etc.)", value: emp.role || "" });
    const sync = () => {
      const arr = (state.answers["section12"]?._employees || []).slice();
      while (arr.length <= idx) arr.push({ name: "", role: "" });
      arr[idx] = { name: nameI.value, role: roleI.value };
      state.answers["section12"] = state.answers["section12"] || {};
      state.answers["section12"]._employees = arr;
      saveDraft();
    };
    nameI.addEventListener("input", sync);
    roleI.addEventListener("input", sync);
    row.appendChild(nameI);
    row.appendChild(roleI);
    wrap.appendChild(row);
  });
  if (rows.length < 5) {
    wrap.appendChild(el("button", {
      type: "button",
      class: "text-sm font-semibold text-maye-primary-400 hover:text-maye-primary-600 transition",
      text: "+ Ongeraho umukozi",
      onclick: () => {
        state.answers["section12"] = state.answers["section12"] || {};
        const arr = (state.answers["section12"]._employees || []).slice();
        arr.push({ name: "", role: "" });
        state.answers["section12"]._employees = arr;
        saveDraft();
        renderSection();
      },
    }));
  }
  return wrap;
}

/* ============================================================
   6. SECTION RENDER
   ============================================================ */
function renderSection() {
  const sec = SECTIONS[state.currentSection];
  const secNum = state.currentSection + 1;
  document.getElementById("sectionNum").textContent = secNum;
  const pct = Math.round((secNum / TOTAL_SECTIONS) * 100);
  document.getElementById("sectionPercent").textContent = pct + "%";
  document.getElementById("progressBar").style.width = pct + "%";
  document.getElementById("sectionTitle").textContent = sec.title;
  document.getElementById("sectionSubtitle").textContent = sec.subtitle || "";

  const body = document.getElementById("sectionBody");
  body.innerHTML = "";

  const answers = state.answers[sec.id] || {};

  sec.fields.forEach(field => {
    if (field.key === "_samples") { body.appendChild(renderField(field, null, () => {})); return; }
    if (field.key === "_employees") { body.appendChild(renderField(field, null, () => {})); return; }
    const value = answers[field.key];
    const onChange = (v) => {
      state.answers[sec.id] = state.answers[sec.id] || {};
      state.answers[sec.id][field.key] = v;
      saveDraft();
    };
    body.appendChild(renderField(field, value, onChange));
  });

  document.getElementById("observationInput").value = state.observations[sec.id] || "";
  document.getElementById("btnPrevSection").disabled = state.currentSection === 0;
  document.getElementById("btnNextSection").textContent =
    state.currentSection === TOTAL_SECTIONS - 1 ? "Reba ibisubizo →" : "Komeza →";
}

document.getElementById("observationInput").addEventListener("input", (e) => {
  const sec = SECTIONS[state.currentSection];
  state.observations[sec.id] = e.target.value;
  saveDraft();
});

/* ============================================================
   7. VALIDATION
   ============================================================ */
function validateSection(idx) {
  const sec = SECTIONS[idx];
  const answers = state.answers[sec.id] || {};
  const missing = [];
  sec.fields.forEach(f => {
    if (f.required && (f.type !== "samples" && f.type !== "employees")) {
      const v = answers[f.key];
      if (v === undefined || v === null || v === "" || (Array.isArray(v) && v.length === 0)) {
        missing.push(f.label);
      }
    }
  });
  if (sec.id === "section3") {
    const valid = state.samples.filter(s => s.name && s.purchaseUnit && s.sellingUnit);
    if (valid.length < 1) missing.push("Sample product imwe byibuze (izina + units)");
  }
  return missing;
}

/* ============================================================
   8. DRAFT PERSISTENCE
   ============================================================ */
const DRAFT_KEY = "MAYE_SIAP_DRAFT";
const DB_NAME = "maye_siap_db";
const DB_STORE = "drafts";

function openIDB() {
  return new Promise((resolve, reject) => {
    const req = indexedDB.open(DB_NAME, 1);
    req.onupgradeneeded = () => {
      const d = req.result;
      if (!d.objectStoreNames.contains(DB_STORE)) d.createObjectStore(DB_STORE);
    };
    req.onsuccess = () => resolve(req.result);
    req.onerror = () => reject(req.error);
  });
}
async function idbSet(key, val) {
  try {
    const d = await openIDB();
    return new Promise((res, rej) => {
      const tx = d.transaction(DB_STORE, "readwrite");
      tx.objectStore(DB_STORE).put(val, key);
      tx.oncomplete = () => res(true);
      tx.onerror = () => rej(tx.error);
    });
  } catch { return false; }
}
async function idbGet(key) {
  try {
    const d = await openIDB();
    return new Promise((res, rej) => {
      const tx = d.transaction(DB_STORE, "readonly");
      const r = tx.objectStore(DB_STORE).get(key);
      r.onsuccess = () => res(r.result);
      r.onerror = () => rej(r.error);
    });
  } catch { return null; }
}
async function idbDel(key) {
  try {
    const d = await openIDB();
    return new Promise((res, rej) => {
      const tx = d.transaction(DB_STORE, "readwrite");
      tx.objectStore(DB_STORE).delete(key);
      tx.oncomplete = () => res(true);
      tx.onerror = () => rej(tx.error);
    });
  } catch { return false; }
}
function saveDraft() {
  idbSet(DRAFT_KEY, {
    currentSection: state.currentSection,
    answers: state.answers,
    observations: state.observations,
    samples: state.samples,
    savedAt: Date.now(),
  });
}
async function loadDraft() { return await idbGet(DRAFT_KEY); }
async function clearDraft() { await idbDel(DRAFT_KEY); }

/* ============================================================
   9. SUBMIT / SYNC
   ============================================================ */
const PENDING_KEY = "MAYE_SIAP_PENDING";

async function queuePending(payload) {
  let q = (await idbGet(PENDING_KEY)) || [];
  q.push(payload);
  await idbSet(PENDING_KEY, q);
}

async function syncPending() {
  if (!state.online || !state.uid) return;
  let q = (await idbGet(PENDING_KEY)) || [];
  if (!q.length) return;
  const remaining = [];
  for (const item of q) {
    try { await writeResponse(item); toast("Draft yabitswe kuri server", "success"); }
    catch { remaining.push(item); }
  }
  await idbSet(PENDING_KEY, remaining);
}

async function writeResponse(payload) {
  const newRef = push(ref(db, "interviewResponses"));
  const responseId = "INT-" + newRef.key.slice(-5).toUpperCase();
  const full = {
    meta: {
      responseId, schemaVersion: SCHEMA_VERSION,
      createdAt: Date.now(), updatedAt: Date.now(),
      submittedBy: state.uid || "anonymous",
      interviewDate: new Date().toISOString().slice(0, 10),
      interviewer: "Steven IRADUKUNDA",
      appVersion: APP_VERSION,
      status: "new", approvedByDeveloper: false, approvedAt: null,
    },
    shopProfile: payload.answers["section1"] || {},
    answers: payload.answers,
    observations: payload.observations,
    samples: payload.samples || [],
    developerAnalysis: null,
    auditTrail: [{
      actorUid: state.uid || "anonymous", action: "created",
      timestamp: Date.now(), details: "Response submitted via interview form",
    }],
  };
  await set(newRef, full);
  return responseId;
}

async function submitInterview() {
  for (let i = 0; i < SECTIONS.length; i++) {
    const missing = validateSection(i);
    if (missing.length) {
      toast("Bura ibisubizo: " + missing.slice(0, 2).join(", "), "error");
      state.currentSection = i;
      showScreen("screenInterview");
      renderSection();
      return;
    }
  }
  const payload = { answers: state.answers, observations: state.observations, samples: state.samples };
  const btn = document.getElementById("btnSubmit");
  btn.disabled = true;
  btn.textContent = "⏳ Turohereza...";
  try {
    if (state.online && state.uid) {
      const responseId = await writeResponse(payload);
      await clearDraft();
      showConfirmation(responseId, false);
    } else {
      await queuePending(payload);
      await clearDraft();
      showConfirmation("INT-PENDING", true);
    }
  } catch (err) {
    console.error(err);
    await queuePending(payload);
    await clearDraft();
    showConfirmation("INT-PENDING", true);
  } finally {
    btn.disabled = false;
    btn.textContent = "✓ Ohereza ibisubizo";
  }
}

function showConfirmation(refId, pending) {
  document.getElementById("confirmationRef").textContent = refId;
  const note = document.getElementById("syncNote");
  if (pending) {
    note.textContent = "⚠ Ibisubizo byabitswe muri telefone yawe. Bizoherezwa iyo internet igarutse.";
    note.classList.remove("hidden");
  } else note.classList.add("hidden");
  showScreen("screenConfirmation");
}

/* ============================================================
   10. REVIEW
   ============================================================ */
function renderReview() {
  const body = document.getElementById("reviewBody");
  body.innerHTML = "";
  SECTIONS.forEach((sec, idx) => {
    const answers = state.answers[sec.id] || {};
    const obs = state.observations[sec.id] || "";
    const card = el("div", { class: "bg-maye-surface border border-maye-border rounded-maye-md p-4" });
    const header = el("div", { class: "flex items-center justify-between gap-3 mb-2" });
    header.appendChild(el("div", { class: "font-bold text-maye-text-strong", text: `${idx + 1}. ${sec.title}` }));
    header.appendChild(el("button", {
      type: "button", class: "text-xs font-semibold text-maye-primary-400 hover:text-maye-primary-600", text: "✏️ Hindura",
      onclick: () => { state.currentSection = idx; showScreen("screenInterview"); renderSection(); },
    }));
    card.appendChild(header);

    const list = el("div", { class: "space-y-1.5 text-sm" });
    sec.fields.forEach(f => {
      if (!f.label || f.type === "samples" || f.type === "employees" || f.type === "note") return;
      const v = answers[f.key];
      if (v === undefined || v === null || v === "" || (Array.isArray(v) && !v.length)) return;
      const row = el("div", { class: "flex flex-col sm:flex-row sm:gap-2" });
      row.appendChild(el("span", { class: "text-maye-text-muted font-semibold min-w-[180px]", text: f.label + ":" }));
      row.appendChild(el("span", { class: "text-maye-text-base", text: Array.isArray(v) ? v.join(", ") : String(v) }));
      list.appendChild(row);
    });
    if (sec.id === "section3" && state.samples.length) {
      const validSamples = state.samples.filter(s => s.name);
      if (validSamples.length) {
        const row = el("div", { class: "flex flex-col sm:flex-row sm:gap-2" });
        row.appendChild(el("span", { class: "text-maye-text-muted font-semibold min-w-[180px]", text: "Samples:" }));
        row.appendChild(el("span", { class: "text-maye-text-base", text: validSamples.map(s => s.name).join(", ") }));
        list.appendChild(row);
      }
    }
    if (obs) {
      const obsRow = el("div", { class: "mt-2 bg-maye-muted border border-maye-border rounded-maye-sm px-3 py-2 text-sm" });
      obsRow.appendChild(el("div", { class: "text-xs font-bold text-maye-primary-600 uppercase tracking-wide mb-0.5", text: "👁 Observation" }));
      obsRow.appendChild(el("div", { class: "text-maye-text-base", text: obs }));
      list.appendChild(obsRow);
    }
    if (!list.children.length) list.appendChild(el("div", { class: "text-maye-text-muted italic text-sm", text: "Nta bisubizo" }));
    card.appendChild(list);
    body.appendChild(card);
  });
}

/* ============================================================
   11. BLUEPRINT GENERATOR
   ============================================================ */
function generateBlueprint(response) {
  const a = response.answers || {};
  const s1 = a.section1 || {}, s2 = a.section2 || {}, s8 = a.section8 || {},
    s9 = a.section9 || {}, s12 = a.section12 || {}, s14 = a.section14 || {};
  const hasVariants = s2.hasVariants === "yego";
  const diffUnits = s2.differentUnits === "yego";
  const creditSales = a.section7?.creditSalesAllowed === "yego";
  const aging = s9.hasAgingReport === "yego";

  const modules = [
    { moduleId: "products", priority: "high",
      rationale: hasVariants || diffUnits ? "Products have variants and/or different purchase/selling units" : "Core product catalog needed",
      entities: ["Product","ProductVariant","UnitConversion"], workflows: ["purchase","sale","return"],
      estimatedComplexity: hasVariants || diffUnits ? "medium" : "low" },
    { moduleId: "stock", priority: "high", rationale: "Stock movement tracking required; opening stock must be counted",
      entities: ["Stock","StockMovement","OpeningStock"], workflows: ["receive","issue","transfer","damage"], estimatedComplexity: "medium" },
    { moduleId: "sales", priority: "high", rationale: creditSales ? "Credit sales common; receipts inconsistent" : "Sales tracking with receipts",
      entities: ["Sale","SaleLine","Payment","Credit"], workflows: ["quote","invoice","payment","refund"],
      estimatedComplexity: creditSales ? "medium" : "low" },
    { moduleId: "purchases", priority: "medium", rationale: "Supplier orders currently informal",
      entities: ["PurchaseOrder","GoodsReceipt","SupplierInvoice"], workflows: ["order","receive","return_to_supplier"], estimatedComplexity: "medium" },
    { moduleId: "debt_ledger", priority: creditSales ? "high" : "low", rationale: aging ? "Aging report exists but manual" : "Aging tracked manually; not reliable",
      entities: ["CustomerLedger","SupplierLedger","AgingBucket"], workflows: ["credit_sale","partial_payment","write_off"],
      estimatedComplexity: creditSales ? "high" : "low" },
    { moduleId: "cash_reconciliation", priority: "high", rationale: "Daily cash counting essential for loss prevention",
      entities: ["CashSession","CashCount","Discrepancy"], workflows: ["open","count","reconcile","close"], estimatedComplexity: "medium" },
    { moduleId: "employees", priority: s1.employeeCount === "0" ? "low" : "medium",
      rationale: s1.employeeCount === "0" ? "Owner-only shop; minimal role separation" : `${s1.employeeCount} employees; role separation needed`,
      entities: ["Employee","Shift","Permission"], workflows: ["clock_in","sale","shift_close"],
      estimatedComplexity: s1.employeeCount === "0" ? "low" : "medium" },
    { moduleId: "reports", priority: "high", rationale: "Owner needs visibility into profit and stock",
      entities: ["DailyReport","StockReport","ProfitReport","AgingReport"], workflows: ["generate","export"], estimatedComplexity: "low" },
  ];

  const sampleTransactions = (response.samples || []).filter(s => s.name).map(s => {
    const qty = s.conversionFactor || 1;
    const revenue = (s.sellingPrice || 0) * qty;
    const cost = (s.purchasePrice || 0) * qty;
    const profit = revenue - cost;
    return {
      description: `Sale of ${qty}${s.sellingUnit || "unit"} ${s.name}`,
      product: s.name, quantity: qty, unit: s.sellingUnit,
      purchaseUnitPrice: s.purchasePrice, sellingUnitPrice: s.sellingPrice,
      totalRevenue: revenue, totalCost: cost, profit,
      profitMargin: revenue > 0 ? Math.round((profit / revenue) * 100) : 0,
    };
  });

  return {
    blueprintId: "BP-" + Math.random().toString(36).slice(2, 7).toUpperCase(),
    generatedAt: Date.now(),
    sourceResponseIds: [response.meta?.responseId || "UNKNOWN"],
    shopProfile: s1,
    detectedModules: modules,
    detectedEntities: [
      { name: "Product", fields: ["id","name","category","purchaseUnit","sellingUnit","conversionFactor"] },
      { name: "ProductVariant", fields: ["productId","size","weight","color"] },
      { name: "Stock", fields: ["productId","variantId","quantity","warehouseId"] },
      { name: "StockMovement", fields: ["id","type","productId","quantity","reason","createdAt"] },
      { name: "Customer", fields: ["id","name","phone","creditLimit","balance"] },
      { name: "Supplier", fields: ["id","name","phone","balance"] },
      { name: "Sale", fields: ["id","customerId","total","paid","status","createdAt"] },
      { name: "Purchase", fields: ["id","supplierId","total","status","createdAt"] },
      { name: "Payment", fields: ["id","saleId","amount","method","createdAt"] },
      { name: "CashSession", fields: ["id","openedAt","closedAt","expected","counted"] },
    ],
    detectedWorkflows: [
      "purchase_order → goods_receipt → stock_increase",
      "sale → invoice → payment → stock_decrease",
      "return → credit_note → stock_increase",
      "damage → write_off → stock_decrease",
      "cash_open → daily_sales → cash_close",
      "credit_sale → aging → follow_up",
    ],
    businessRules: [
      `Selling price = purchase price × (1 + markup%); markup default = ${s8.standardMarkup || 20}%`,
      s8.retailWholesaleDiff === "yego" ? "Wholesale prices differ from retail" : "Uniform retail pricing",
      creditSales ? "Credit sales allowed with customer credit limit" : "No credit sales",
      "Aging buckets: 0-30, 31-60, 61-90, 90+ days",
      s12.priceChangeApprovedBy ? `Price change requires approval from: ${s12.priceChangeApprovedBy}` : "Price change approval not specified",
    ],
    sampleTransactions,
    techRecommendations: {
      frontend: "HTML5 + CSS3 + Vanilla JS (no framework)",
      backend: "Firebase Realtime Database + Anonymous Auth",
      offline: "IndexedDB queue", pwa: "manifest embedded + sw.js",
      hosting: "Netlify or Firebase Hosting",
      blazeUpgrade: "Recommended if > 100 responses or custom claims needed",
    },
    acceptanceTests: [
      "Can create a product with purchase unit carton and selling unit kg",
      "Can sell 25 kg and stock decreases by 1 carton",
      "Cash close shows expected vs counted and detects discrepancies",
      "Aging report correctly buckets 30/60/90+ days",
      "Credit sale blocked when credit limit exceeded",
    ],
    interviewSummary: {
      shopName: s1.shopName || "Unknown", ownerName: s1.ownerName || "Unknown",
      district: s1.district || "Unknown", shopType: s1.shopType || "Unknown",
      employeeCount: s1.employeeCount || "Unknown",
      budget: s14.budget || "Unknown", timeline: s14.timeline || "Unknown",
      hasSmartphone: s14.hasSmartphone === "yego", internetQuality: s14.internetQuality || "unknown",
    },
  };
}

/* ============================================================
   12. DASHBOARD
   ============================================================ */
async function loadResponses() {
  const listEl = document.getElementById("responseList");
  listEl.innerHTML = `
    <div class="space-y-3">
      <div class="skeleton h-20 w-full"></div>
      <div class="skeleton h-20 w-full"></div>
      <div class="skeleton h-20 w-full"></div>
    </div>`;
  try {
    const q = query(ref(db, "interviewResponses"), orderByChild("meta/createdAt"), limitToLast(500));
    const snap = await get(q);
    if (!snap.exists()) {
      state.responses = [];
      renderStats();
      listEl.innerHTML = `
        <div class="text-center text-maye-text-muted py-12 text-sm">
          <div class="text-5xl mb-3">📋</div>
          <div class="font-bold text-maye-text-strong mb-1">Nta bisubizo biraboneka</div>
          <div>Steven aratangira ikiganiro cya mbere.</div>
        </div>`;
      return;
    }
    const arr = [];
    snap.forEach(child => {
      const v = child.val();
      arr.push({ _key: child.key, ...v });
    });
    arr.sort((a, b) => (b.meta?.createdAt || 0) - (a.meta?.createdAt || 0));
    state.responses = arr;
    renderStats();
    renderResponseList();
    populateDistrictFilter();
  } catch (err) {
    console.error(err);
    listEl.innerHTML = `
      <div class="text-center text-maye-danger py-10 text-sm">
        <div class="text-4xl mb-2">⚠️</div>
        <div class="font-bold mb-1">Ntibyakunze kuzamura ibisubizo</div>
        <div>Reba ko UID yawe iri muri adminAllowList muri Firebase Console.</div>
        <div class="mt-3"><button id="retryLoad" class="px-4 py-2 rounded-maye-md bg-maye-primary text-white text-sm font-bold">🔄 Retry</button></div>
      </div>`;
    document.getElementById("retryLoad")?.addEventListener("click", loadResponses);
  }
}

function renderStats() {
  const total = state.responses.length;
  const newC = state.responses.filter(r => (r.meta?.status || "new") === "new").length;
  const reviewed = state.responses.filter(r => r.meta?.status === "reviewed").length;
  const ready = state.responses.filter(r => r.meta?.status === "blueprint_ready").length;
  document.getElementById("statTotal").textContent = total;
  document.getElementById("statNew").textContent = newC;
  document.getElementById("statReviewed").textContent = reviewed;
  document.getElementById("statReady").textContent = ready;
}

function populateDistrictFilter() {
  const sel = document.getElementById("fDistrict");
  const current = sel.value;
  const districts = new Set();
  state.responses.forEach(r => {
    const d = r.shopProfile?.district || r.answers?.section1?.district;
    if (d) districts.add(d);
  });
  sel.innerHTML = `<option value="">Akarere kose</option>`;
  [...districts].sort().forEach(d => {
    const o = document.createElement("option");
    o.value = d; o.textContent = d;
    sel.appendChild(o);
  });
  sel.value = current;
}

function applyFilters(list) {
  const search = document.getElementById("fSearch").value.trim().toLowerCase();
  const district = document.getElementById("fDistrict").value;
  const status = document.getElementById("fStatus").value;
  const budget = document.getElementById("fBudget").value;
  return list.filter(r => {
    const s1 = r.shopProfile || r.answers?.section1 || {};
    const s14 = r.answers?.section14 || {};
    if (search) {
      const hay = `${s1.shopName || ""} ${s1.ownerName || ""}`.toLowerCase();
      if (!hay.includes(search)) return false;
    }
    if (district && s1.district !== district) return false;
    if (status && (r.meta?.status || "new") !== status) return false;
    if (budget && s14.budget !== budget) return false;
    return true;
  });
}

function renderResponseList() {
  const listEl = document.getElementById("responseList");
  const filtered = applyFilters(state.responses);
  if (!filtered.length) {
    listEl.innerHTML = `
      <div class="text-center text-maye-text-muted py-10 text-sm">
        <div class="text-4xl mb-2">🔍</div>
        Nta bisubizo bihuye n'ibyo washakishije.
      </div>`;
    return;
  }
  listEl.innerHTML = "";
  filtered.forEach(r => {
    const s1 = r.shopProfile || r.answers?.section1 || {};
    const meta = r.meta || {};
    const statusColors = {
      new: "bg-maye-info/10 text-maye-info border-maye-info/30",
      reviewed: "bg-maye-warning/10 text-maye-warning border-maye-warning/30",
      blueprint_ready: "bg-maye-success/10 text-maye-success border-maye-success/30",
    };
    const statusLabels = { new: "🆕 New", reviewed: "👁 Reviewed", blueprint_ready: "✅ Blueprint Ready" };
    const card = el("div", {
      class: "bg-white border border-maye-border rounded-maye-md p-4 hover:shadow-maye-md transition cursor-pointer",
      onclick: () => openResponseDetail(r._key),
    });
    const top = el("div", { class: "flex items-start justify-between gap-3" });
    const left = el("div", { class: "min-w-0" });
    left.appendChild(el("div", { class: "font-bold text-maye-text-strong truncate", text: s1.shopName || "Izina ritazwi" }));
    left.appendChild(el("div", { class: "text-xs text-maye-text-muted mt-0.5", text: `${s1.ownerName || "—"} • ${s1.district || "—"} • ${s1.shopType || "—"}` }));
    left.appendChild(el("div", { class: "text-xs text-maye-text-muted mt-1 font-mono", text: meta.responseId || r._key }));
    top.appendChild(left);

    const badges = el("div", { class: "flex items-center gap-1 shrink-0" });
    if (meta.approvedByDeveloper) badges.appendChild(el("span", { class: "text-xs font-bold px-2 py-1 rounded-full bg-maye-accent/20 text-maye-primary border border-maye-accent/40", text: "✓ Approved" }));
    badges.appendChild(el("span", {
      class: `text-xs font-bold px-2.5 py-1 rounded-full border ${statusColors[meta.status || "new"] || statusColors.new}`,
      text: statusLabels[meta.status || "new"] || "New",
    }));
    top.appendChild(badges);
    card.appendChild(top);

    const bottom = el("div", { class: "mt-2 flex items-center gap-3 text-xs text-maye-text-muted flex-wrap" });
    bottom.appendChild(el("span", { text: "📅 " + (meta.interviewDate || "—") }));
    if (r.answers?.section14?.budget) bottom.appendChild(el("span", { text: "💰 " + r.answers.section14.budget }));
    if (r.samples?.length) bottom.appendChild(el("span", { text: `📦 ${r.samples.length} samples` }));
    if (meta.updatedAt && meta.updatedAt !== meta.createdAt) {
      const date = new Date(meta.updatedAt).toLocaleDateString();
      bottom.appendChild(el("span", { text: `✏️ ${date}` }));
    }
    card.appendChild(bottom);

    listEl.appendChild(card);
  });
}

document.getElementById("fSearch").addEventListener("input", renderResponseList);
document.getElementById("fDistrict").addEventListener("change", renderResponseList);
document.getElementById("fStatus").addEventListener("change", renderResponseList);
document.getElementById("fBudget").addEventListener("change", renderResponseList);
document.getElementById("btnClearFilters").addEventListener("click", () => {
  document.getElementById("fSearch").value = "";
  document.getElementById("fDistrict").value = "";
  document.getElementById("fStatus").value = "";
  document.getElementById("fBudget").value = "";
  renderResponseList();
});

/* ============================================================
   13. RESPONSE DETAIL
   ============================================================ */
async function openResponseDetail(key) {
  state.currentResponseId = key;
  const r = state.responses.find(x => x._key === key);
  if (!r) { toast("Ntibyakunze kubona response", "error"); return; }

  showScreen("screenDetail");
  const body = document.getElementById("detailBody");
  body.innerHTML = "";

  const s1 = r.shopProfile || r.answers?.section1 || {};
  const meta = r.meta || {};

  const header = el("div", { class: "bg-maye-primary text-white rounded-maye-lg shadow-maye-md p-5 sm:p-6" });
  header.appendChild(el("div", { class: "text-xs text-maye-accent font-bold uppercase tracking-wide", text: meta.responseId || "—" }));
  header.appendChild(el("h2", { class: "text-2xl font-bold mt-1", text: s1.shopName || "Izina ritazwi" }));
  header.appendChild(el("p", { class: "text-white/80 text-sm mt-1", text: `${s1.ownerName || "—"} • ${s1.ownerPhone || "—"} • ${s1.district || "—"} • ${s1.shopType || "—"}` }));
  header.appendChild(el("p", { class: "text-white/60 text-xs mt-2", text: `📅 ${meta.interviewDate || "—"} • Submitted by: ${meta.submittedBy || "—"}` }));

  // Action buttons in header
  const actions = el("div", { class: "flex flex-wrap gap-2 mt-3 no-print" });
  actions.appendChild(el("button", {
    type: "button",
    class: "px-3 py-1.5 rounded-maye-sm bg-white/10 hover:bg-white/20 text-xs font-bold transition",
    text: "📄 PDF",
    onclick: () => downloadResponsePdf(r),
  }));
  actions.appendChild(el("button", {
    type: "button",
    class: "px-3 py-1.5 rounded-maye-sm bg-white/10 hover:bg-white/20 text-xs font-bold transition",
    text: "📥 JSON",
    onclick: () => downloadResponseJson(r),
  }));
  header.appendChild(actions);
  body.appendChild(header);

  const tabs = el("div", { class: "bg-maye-surface border border-maye-border rounded-maye-lg shadow-maye-sm overflow-hidden" });
  const tabBar = el("div", { class: "flex border-b border-maye-border overflow-x-auto" });
  const tabNames = ["📋 Ibisubizo", "👁 Observations", "📦 Samples", "🔍 Analysis"];
  const tabContents = {};
  let activeTab = 0;
  const tabButtons = [];

  const switchTab = (idx) => {
    activeTab = idx;
    tabButtons.forEach((b, i) => {
      b.className = i === idx
        ? "px-4 py-3 text-sm font-bold text-maye-primary border-b-2 border-maye-accent bg-maye-muted whitespace-nowrap"
        : "px-4 py-3 text-sm font-semibold text-maye-text-muted hover:text-maye-primary border-b-2 border-transparent whitespace-nowrap";
    });
    Object.entries(tabContents).forEach(([k, v]) => { v.style.display = Number(k) === idx ? "block" : "none"; });
  };
  tabNames.forEach((name, idx) => {
    const b = el("button", { type: "button", text: name });
    b.addEventListener("click", () => switchTab(idx));
    tabBar.appendChild(b);
    tabButtons.push(b);
  });
  tabs.appendChild(tabBar);

  // Tab 0: Answers
  const answersEl = el("div", { class: "p-5 sm:p-6 space-y-4" });
  SECTIONS.forEach((sec, idx) => {
    const a = r.answers?.[sec.id] || {};
    const card = el("div", { class: "border border-maye-border rounded-maye-md p-4" });
    card.appendChild(el("div", { class: "font-bold text-maye-text-strong mb-2", text: `${idx + 1}. ${sec.title}` }));
    const grid = el("div", { class: "grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm" });
    let any = false;
    sec.fields.forEach(f => {
      if (!f.label || f.type === "samples" || f.type === "employees" || f.type === "note") return;
      const v = a[f.key];
      if (v === undefined || v === null || v === "" || (Array.isArray(v) && !v.length)) return;
      any = true;
      const row = el("div", { class: "flex flex-col" });
      row.appendChild(el("span", { class: "text-xs text-maye-text-muted font-semibold", text: f.label }));
      row.appendChild(el("span", { class: "text-maye-text-base", text: Array.isArray(v) ? v.join(", ") : String(v) }));
      grid.appendChild(row);
    });
    card.appendChild(any ? grid : el("div", { class: "text-maye-text-muted italic text-sm", text: "Nta bisubizo" }));
    answersEl.appendChild(card);
  });
  tabContents[0] = answersEl;

  // Tab 1: Observations
  const obsEl = el("div", { class: "p-5 sm:p-6 space-y-3" });
  let anyObs = false;
  SECTIONS.forEach((sec, idx) => {
    const o = r.observations?.[sec.id];
    if (!o) return;
    anyObs = true;
    const card = el("div", { class: "bg-maye-muted border border-maye-border rounded-maye-md p-4" });
    card.appendChild(el("div", { class: "font-bold text-maye-primary-600 text-sm", text: `${idx + 1}. ${sec.title}` }));
    card.appendChild(el("div", { class: "text-maye-text-base text-sm mt-1 whitespace-pre-wrap", text: o }));
    obsEl.appendChild(card);
  });
  if (!anyObs) obsEl.appendChild(el("div", { class: "text-maye-text-muted italic text-center py-6", text: "Nta observations" }));
  tabContents[1] = obsEl;

  // Tab 2: Samples
  const samplesEl = el("div", { class: "p-5 sm:p-6 space-y-3" });
  if (r.samples?.length) {
    r.samples.forEach((s, i) => {
      const card = el("div", { class: "border border-maye-border rounded-maye-md p-4" });
      card.appendChild(el("div", { class: "font-bold text-maye-text-strong", text: `📦 Sample #${i + 1}: ${s.name || "—"}` }));
      const grid = el("div", { class: "grid grid-cols-2 sm:grid-cols-3 gap-2 text-sm mt-2" });
      [["Size", s.size],["Purchase Unit", s.purchaseUnit],["Selling Unit", s.sellingUnit],
       ["Conversion", s.conversionFactor],["Purchase Price", s.purchasePrice + " " + (s.purchaseCurrency || "")],
       ["Selling Price", s.sellingPrice + " " + (s.sellingCurrency || "")],
       ["Stock", s.currentStock],["Supplier", s.supplierName],
       ["Expires", s.expires ? "Yego" : "Oya"],["Damages Easily", s.damagesEasily ? "Yego" : "Oya"]]
        .forEach(([k, v]) => {
          if (v === undefined || v === null || v === "") return;
          const row = el("div");
          row.appendChild(el("div", { class: "text-xs text-maye-text-muted font-semibold", text: k }));
          row.appendChild(el("div", { class: "text-maye-text-base", text: String(v) }));
          grid.appendChild(row);
        });
      card.appendChild(grid);
      if (s.notes) card.appendChild(el("div", { class: "mt-2 text-sm text-maye-text-base italic", text: s.notes }));
      samplesEl.appendChild(card);
    });
  } else samplesEl.appendChild(el("div", { class: "text-maye-text-muted italic text-center py-6", text: "Nta samples" }));
  tabContents[2] = samplesEl;

  // Tab 3: Analysis
  const analysisEl = el("div", { class: "p-5 sm:p-6 space-y-4" });
  const da = r.developerAnalysis || {};
  analysisEl.appendChild(el("label", { class: "block text-sm font-bold text-maye-text-strong", text: "Analysis Notes (developer)" }));
  const notesTa = el("textarea", { class: "w-full bg-white border border-maye-border rounded-maye-md px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-maye-accent", rows: 4 });
  notesTa.value = da.analysisNotes || "";
  analysisEl.appendChild(notesTa);

  const statusRow = el("div", { class: "grid grid-cols-1 sm:grid-cols-2 gap-3" });
  const statusWrap = el("div");
  statusWrap.appendChild(el("label", { class: "block text-xs font-bold text-maye-text-muted mb-1", text: "Status" }));
  const statusSel = el("select", { class: "w-full bg-white border border-maye-border rounded-maye-md px-3.5 py-2.5 text-sm" });
  ["new", "reviewed", "blueprint_ready"].forEach(v => {
    const o = el("option", { value: v, text: v.replace("_", " ").toUpperCase() });
    if ((meta.status || "new") === v) o.selected = true;
    statusSel.appendChild(o);
  });
  statusWrap.appendChild(statusSel);
  statusRow.appendChild(statusWrap);

  const complexWrap = el("div");
  complexWrap.appendChild(el("label", { class: "block text-xs font-bold text-maye-text-muted mb-1", text: "Complexity" }));
  const complexSel = el("select", { class: "w-full bg-white border border-maye-border rounded-maye-md px-3.5 py-2.5 text-sm" });
  ["low", "medium", "high"].forEach(v => {
    const o = el("option", { value: v, text: v.toUpperCase() });
    if ((da.complexity || "medium") === v) o.selected = true;
    complexSel.appendChild(o);
  });
  complexWrap.appendChild(complexSel);
  statusRow.appendChild(complexWrap);
  analysisEl.appendChild(statusRow);

  const approvedRow = el("div", { class: "flex items-center gap-2 pt-1" });
  const approvedCheck = el("input", { type: "checkbox", class: "w-5 h-5 accent-maye-success" });
  approvedCheck.checked = !!da.approved;
  approvedRow.appendChild(approvedCheck);
  approvedRow.appendChild(el("label", { class: "text-sm font-semibold text-maye-text-strong", text: "✓ Approved by Developer" }));
  analysisEl.appendChild(approvedRow);

  const actionBtns = el("div", { class: "flex flex-col sm:flex-row gap-2 pt-2" });
  const saveBtn = el("button", {
    type: "button",
    class: "flex-1 px-5 py-2.5 rounded-maye-md bg-maye-primary hover:bg-maye-primary-600 text-white font-bold shadow-maye-sm transition",
    text: "💾 Save Analysis",
  });
  saveBtn.addEventListener("click", async () => {
    try {
      await update(ref(db, `interviewResponses/${key}/developerAnalysis`), {
        reviewedBy: state.uid, reviewedAt: Date.now(),
        analysisNotes: notesTa.value, complexity: complexSel.value,
        approved: approvedCheck.checked,
        approvedAt: approvedCheck.checked ? Date.now() : null,
      });
      await update(ref(db, `interviewResponses/${key}/meta`), {
        status: statusSel.value, approvedByDeveloper: approvedCheck.checked,
        approvedAt: approvedCheck.checked ? Date.now() : null,
        updatedAt: Date.now(),
      });
      toast("Analysis yabitswe", "success");
      const resp = state.responses.find(x => x._key === key);
      if (resp) {
        resp.developerAnalysis = { ...(resp.developerAnalysis || {}), analysisNotes: notesTa.value, complexity: complexSel.value, approved: approvedCheck.checked };
        resp.meta = { ...(resp.meta || {}), status: statusSel.value, approvedByDeveloper: approvedCheck.checked };
      }
      renderResponseList();
      renderStats();
    } catch (err) {
      console.error(err);
      toast("Ntibyakunze kubika analysis", "error");
    }
  });
  actionBtns.appendChild(saveBtn);

  const blueprintBtn = el("button", {
    type: "button",
    class: "flex-1 px-5 py-2.5 rounded-maye-md bg-maye-accent hover:brightness-95 text-maye-primary font-bold shadow-maye-sm transition",
    text: "🔨 Generate Blueprint",
  });
  blueprintBtn.addEventListener("click", async () => {
    const bp = generateBlueprint(r);
    r.developerAnalysis = r.developerAnalysis || {};
    r.developerAnalysis.blueprintJson = bp;
    r.developerAnalysis.detectedModules = bp.detectedModules.map(m => m.moduleId);
    r.developerAnalysis.detectedEntities = bp.detectedEntities.map(e => e.name);
    r.developerAnalysis.detectedWorkflows = bp.detectedWorkflows;
    try {
      await update(ref(db, `interviewResponses/${key}/developerAnalysis`), {
        blueprintJson: bp,
        detectedModules: r.developerAnalysis.detectedModules,
        detectedEntities: r.developerAnalysis.detectedEntities,
        detectedWorkflows: r.developerAnalysis.detectedWorkflows,
      });
      toast("Blueprint yabitswe", "success");
    } catch (e) { console.warn("Blueprint save failed", e); }
    state.currentBlueprint = bp;
    renderBlueprintScreen(bp);
    showScreen("screenBlueprint");
  });
  actionBtns.appendChild(blueprintBtn);
  analysisEl.appendChild(actionBtns);

  if (da.blueprintJson) {
    const bpWrap = el("div", { class: "pt-2" });
    bpWrap.appendChild(el("button", {
      type: "button",
      class: "w-full px-4 py-2 rounded-maye-md bg-maye-muted hover:bg-maye-border text-sm font-semibold text-maye-primary-400",
      text: "👁 Reba blueprint yabitswe",
      onclick: () => {
        state.currentBlueprint = da.blueprintJson;
        renderBlueprintScreen(da.blueprintJson);
        showScreen("screenBlueprint");
      },
    }));
    analysisEl.appendChild(bpWrap);
  }
  tabContents[3] = analysisEl;

  Object.entries(tabContents).forEach(([k, v]) => {
    if (Number(k) !== 0) v.style.display = "none";
    tabs.appendChild(v);
  });

  body.appendChild(tabs);
  switchTab(0);
}

