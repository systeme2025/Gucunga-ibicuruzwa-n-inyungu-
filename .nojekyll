/* ============================================================
   1. STATE
   ============================================================ */
const state = {
  uid: null,
  screen: "screenLoading",
  currentSection: 0,
  answers: {},
  observations: {},
  samples: [],
  responses: [],
  currentResponseId: null,
  currentBlueprint: null,
  isAdmin: false,
  online: navigator.onLine,
  uidVisible: false,
};

/* ============================================================
   2. SCREENS
   ============================================================ */
function showScreen(id, flex = false) {
  document.querySelectorAll(".screen").forEach(el => {
    el.classList.remove("active", "flex-active");
  });
  const el = document.getElementById(id);
  if (!el) return;
  el.classList.add(flex ? "flex-active" : "active");
  state.screen = id;
  window.scrollTo({ top: 0, behavior: "smooth" });
}

/* ============================================================
   3. TOAST (with icons)
   ============================================================ */
function toast(msg, type = "") {
  const icons = { success: "✓", error: "✕", warn: "⚠", "": "ℹ" };
  const div = document.createElement("div");
  div.className = "toast" + (type ? " " + type : "");
  div.innerHTML = `<span class="text-lg">${icons[type] || "ℹ"}</span><span>${msg}</span>`;
  document.getElementById("toastContainer").appendChild(div);
  setTimeout(() => { div.style.opacity = "0"; div.style.transition = "opacity .3s"; }, 2600);
  setTimeout(() => div.remove(), 3000);
}

/* ============================================================
   4. SECTION DEFINITIONS
