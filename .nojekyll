<link rel="manifest" href='data:application/json,{"name":"MAYE Shop Interview","short_name":"MAYE SIAP","description":"Interview & Analysis Platform — Powered by MAYE SYSTEM","start_url":"./index.html","display":"standalone","background_color":"#0b2545","theme_color":"#0b2545","orientation":"portrait","icons":[{"src":"https://ik.imagekit.io/73qho7kh9/file_000000003e9471f88734aae4d52e7513%20(1).png","sizes":"192x192","type":"image/png","purpose":"any"},{"src":"https://ik.imagekit.io/73qho7kh9/file_000000003e9471f88734aae4d52e7513%20(1).png","sizes":"512x512","type":"image/png","purpose":"any maskable"}]}' />

<!-- Tailwind CSS Play CDN -->
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          'maye-primary': '#0b2545',
          'maye-primary-600': '#13315c',
          'maye-primary-400': '#1d4f91',
          'maye-accent': '#d4af37',
          'maye-success': '#0f9d58',
          'maye-warning': '#f4b400',
          'maye-danger': '#d93025',
          'maye-info': '#1a73e8',
          'maye-bg': '#f4f6fb',
          'maye-surface': '#ffffff',
          'maye-muted': '#eef1f7',
          'maye-text-strong': '#0b1524',
          'maye-text-base': '#1f2a37',
          'maye-text-muted': '#5b6675',
          'maye-border': '#e3e8f0',
          'maye-border-strong': '#c8d1de',
        },
        fontFamily: {
          'maye': ['-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica Neue','Arial','sans-serif'],
        },
        borderRadius: {
          'maye-sm': '8px',
          'maye-md': '12px',
          'maye-lg': '16px',
        },
        boxShadow: {
          'maye-sm': '0 1px 2px rgba(11,37,69,0.06)',
          'maye-md': '0 4px 14px rgba(11,37,69,0.08)',
          'maye-lg': '0 12px 40px rgba(11,37,69,0.16)',
        },
      },
    },
  };
</script>

<!-- html2pdf.js for PDF export -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<style>
  :root { color-scheme: light; }
  html, body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; }
  body { background: #f4f6fb; color: #1f2a37; -webkit-font-smoothing: antialiased; }
  * { -webkit-tap-highlight-color: transparent; }

  .screen { display: none; }
  .screen.active { display: block; }
  .screen.flex-active { display: flex; }

  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-track { background: #eef1f7; }
  ::-webkit-scrollbar-thumb { background: #c8d1de; border-radius: 8px; }
  ::-webkit-scrollbar-thumb:hover { background: #9aa8bd; }

  @keyframes spin { to { transform: rotate(360deg); } }
  .maye-spinner {
    width: 56px; height: 56px; border-radius: 50%;
    border: 4px solid rgba(212,175,55,0.2);
    border-top-color: #d4af37;
    animation: spin 0.9s linear infinite;
  }

  @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
  .fade-in { animation: fadeIn 0.35s ease-out; }

  @keyframes pulseSoft { 0%,100% { opacity: 1; } 50% { opacity: 0.55; } }
  .pulse-soft { animation: pulseSoft 1.8s ease-in-out infinite; }

  @keyframes slideUp { from { opacity: 0; transform: translate(-50%, 20px); } to { opacity: 1; transform: translate(-50%, 0); } }

  .toast {
    position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%);
    background: #0b2545; color: #fff; padding: 12px 20px; border-radius: 12px;
    box-shadow: 0 12px 40px rgba(11,37,69,0.28); font-size: 14px; font-weight: 600;
    z-index: 9999; max-width: 90vw; text-align: center;
    display: flex; align-items: center; gap: 8px;
    animation: slideUp 0.25s ease-out;
  }
  .toast.success { background: #0f9d58; }
  .toast.error { background: #d93025; }
  .toast.warn { background: #f4b400; color: #0b1524; }

  button:focus-visible, a:focus-visible, input:focus-visible,
  select:focus-visible, textarea:focus-visible {
    outline: 2px solid #d4af37; outline-offset: 2px;
  }

  input[type=number]::-webkit-outer-spin-button,
  input[type=number]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  input[type=number] { -moz-appearance: textfield; }

  .json-view {
    background: #0b1524; color: #d4f1e0; font-family: ui-monospace, Menlo, Consolas, monospace;
    font-size: 12.5px; line-height: 1.55; border-radius: 12px; padding: 16px;
    overflow: auto; max-height: 60vh; white-space: pre;
  }

  /* Skeleton */
  @keyframes skeleton { 0%,100% { opacity: 0.5; } 50% { opacity: 1; } }
  .skeleton {
    background: linear-gradient(90deg, #eef1f7 25%, #e3e8f0 50%, #eef1f7 75%);
    background-size: 200% 100%;
    animation: skeleton 1.4s ease-in-out infinite;
    border-radius: 8px;
  }

  /* Print — basic fallback (PDF uses html2pdf, not print) */
  @media print {
    body { background: #fff !important; }
    .no-print { display: none !important; }
  }

  /* PDF-specific styles (applied to .pdf-doc container before html2pdf) */
  .pdf-doc {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
    color: #0b1524;
    background: #fff;
    width: 210mm;
    padding: 20mm;
  }
  .pdf-doc h1 { font-size: 24pt; color: #0b2545; margin: 0 0 8mm 0; }
  .pdf-doc h2 { font-size: 16pt; color: #0b2545; margin: 6mm 0 3mm 0; border-bottom: 2px solid #d4af37; padding-bottom: 2mm; }
  .pdf-doc h3 { font-size: 12pt; color: #13315c; margin: 4mm 0 2mm 0; }
  .pdf-doc p { font-size: 10pt; line-height: 1.5; margin: 0 0 2mm 0; }
  .pdf-doc .pdf-label { font-size: 9pt; color: #5b6675; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
  .pdf-doc .pdf-value { font-size: 10pt; color: #0b1524; margin-bottom: 2mm; }
  .pdf-doc .pdf-row { display: flex; gap: 4mm; margin-bottom: 2mm; }
  .pdf-doc .pdf-col { flex: 1; }
  .pdf-doc .pdf-card {
    background: #f4f6fb; border-left: 4px solid #0b2545; padding: 4mm; margin: 3mm 0;
    border-radius: 2mm;
  }
  .pdf-doc .pdf-cover {
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    min-height: 250mm; text-align: center;
  }
  .pdf-doc .pdf-cover img { width: 30mm; height: 30mm; margin-bottom: 10mm; }
  .pdf-doc .pdf-cover .pdf-title { font-size: 28pt; color: #0b2545; font-weight: bold; margin-bottom: 4mm; }
  .pdf-doc .pdf-cover .pdf-subtitle { font-size: 14pt; color: #d4af37; margin-bottom: 20mm; }
  .pdf-doc .pdf-cover .pdf-meta { font-size: 10pt; color: #5b6675; margin: 2mm 0; }
  .pdf-doc .pdf-cover .pdf-ref {
    font-size: 12pt; color: #0b2545; font-weight: bold;
    background: #f4f6fb; padding: 4mm 8mm; border-radius: 2mm; margin-top: 10mm;
  }
  .pdf-doc .pdf-footer {
    font-size: 8pt; color: #5b6675; text-align: center;
    padding-top: 4mm; border-top: 1px solid #e3e8f0; margin-top: 6mm;
  }
  .pdf-doc .pdf-badge {
    display: inline-block; padding: 1.5mm 3mm; border-radius: 2mm;
    font-size: 8pt; font-weight: bold;
  }
  .pdf-doc .pdf-badge-new { background: #e6f0fb; color: #1a73e8; }
  .pdf-doc .pdf-badge-reviewed { background: #fff4e5; color: #f4b400; }
  .pdf-doc .pdf-badge-ready { background: #e6f4ea; color: #0f9d58; }
</style>
</head>
<body class="min-h-screen bg-maye-bg font-maye text-maye-text-base">

<!-- ============================================================
     GLOBAL HEADER
     ============================================================ -->
<header class="bg-maye-primary text-white shadow-maye-md no-print">
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between gap-3">
    <div class="flex items-center gap-3 min-w-0">
      <img src="https://ik.imagekit.io/73qho7kh9/file_000000003e9471f88734aae4d52e7513%20(1).png"
           alt="MAYE" class="h-9 w-9 rounded-maye-sm object-contain bg-white p-0.5 shrink-0" />
      <div class="min-w-0">
        <div class="text-sm font-bold leading-tight truncate">MAYE Shop Interview</div>
        <div class="text-[11px] text-maye-accent leading-tight truncate">Powered by MAYE SYSTEM</div>
      </div>
    </div>
    <div class="flex items-center gap-2 text-xs">
      <span id="connBadge" class="hidden sm:inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-white/10">
        <span class="w-2 h-2 rounded-full bg-maye-success"></span> Online
      </span>
      <button id="btnHelp" aria-label="Ubufasha" class="px-3 py-1.5 rounded-maye-sm bg-white/10 hover:bg-white/20 transition font-semibold">
        ❓ Ubufasha
      </button>
    </div>
  </div>
</header>

<!-- ============================================================
     MAIN
     ============================================================ -->
<main class="max-w-6xl mx-auto px-4 py-6">

  <!-- ============ SCREEN: LOADING ============ -->
  <section id="screenLoading" class="screen flex-active flex-col items-center justify-center min-h-[60vh] gap-6">
    <div class="maye-spinner"></div>
    <p class="text-maye-text-muted font-semibold">Turateganya...</p>
    <p id="loadingError" class="hidden text-maye-danger text-sm text-center max-w-md"></p>
  </section>

  <!-- ============ SCREEN: WELCOME ============ -->
  <section id="screenWelcome" class="screen">
    <div class="bg-maye-surface rounded-maye-lg shadow-maye-md border border-maye-border overflow-hidden fade-in">
      <div class="bg-maye-primary text-white p-6 sm:p-8">
        <div class="flex items-center gap-4">
          <img src="https://ik.imagekit.io/73qho7kh9/file_000000003e9471f88734aae4d52e7513%20(1).png"
               alt="MAYE" class="h-14 w-14 rounded-maye-md object-contain bg-white p-1" />
          <div>
            <h1 class="text-2xl sm:text-3xl font-bold leading-tight">Murakaza neza!</h1>
            <p class="text-maye-accent text-sm mt-1">Ikiganiro cyo kumenya uko iduka ryanyu rikora</p>
          </div>
        </div>
      </div>
      <div class="p-6 sm:p-8 space-y-4">
        <p class="text-maye-text-base leading-relaxed">
          Iki ni ikiganiro kigufi cyo kumenya uko iduka ryanyu rikora.
          Ntabwo ari ikizamini — nta gisubizo cy'ukuri cyangwa ikinyoma.
        </p>
        <p class="text-maye-text-base leading-relaxed">
          Ibisubizo byanyu bizadufasha kubaka sisitemu ikorera iduka ryanyu neza.
        </p>
        <div class="bg-maye-muted border border-maye-border rounded-maye-md p-4 text-sm text-maye-text-base">
          <div class="font-bold mb-1">⏱ Igihe giteganyijwe: iminota 25–35</div>
          <div class="text-maye-text-muted">🔒 Amakuru yose arinzwe. Nta muntu ushobora kubona ibisubizo byanyu atabifitiye uburenganzira.</div>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <button id="btnStartInterview"
            class="flex-1 bg-maye-primary hover:bg-maye-primary-600 text-white font-bold px-6 py-3.5 rounded-maye-md shadow-maye-md transition">
            🚀 Tangira ikiganiro
          </button>
          <button id="btnResumeDraft"
            class="hidden flex-1 bg-maye-warning hover:brightness-95 text-maye-primary font-bold px-6 py-3.5 rounded-maye-md shadow-maye-md transition">
            📝 Komeza draft yawe
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SCREEN: INTERVIEW ============ -->
  <section id="screenInterview" class="screen">
    <div class="mb-4 no-print">
      <div class="flex items-center justify-between text-xs font-semibold text-maye-text-muted mb-1.5">
        <span>Igice <span id="sectionNum">1</span> / 14</span>
        <span id="sectionPercent">7%</span>
      </div>
      <div class="h-2 bg-maye-muted rounded-full overflow-hidden">
        <div id="progressBar" class="h-full bg-maye-accent rounded-full transition-all duration-300" style="width:7%"></div>
      </div>
    </div>

    <div class="bg-maye-surface rounded-maye-lg shadow-maye-md border border-maye-border fade-in">
      <div class="border-b border-maye-border p-5 sm:p-6">
        <h2 id="sectionTitle" class="text-xl sm:text-2xl font-bold text-maye-text-strong">Igice</h2>
        <p id="sectionSubtitle" class="text-sm text-maye-text-muted mt-1"></p>
      </div>
      <div id="sectionBody" class="p-5 sm:p-6 space-y-5"></div>
      <div id="observationBox" class="border-t border-maye-border p-5 sm:p-6 bg-maye-muted/60">
        <label class="block text-sm font-bold text-maye-primary-600 mb-1.5">
          👁 Ibyo wabonye (Observation — si ibyo nyir'iduka yavuze)
        </label>
        <textarea id="observationInput" rows="3"
          class="w-full bg-white border border-maye-border rounded-maye-md px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-maye-accent focus:border-maye-primary-400"
          placeholder="Urugero: Nyir'iduka avuga ko afite imifuka 100 bya cement, ariko nk'uko mbibona ni 40 gusa..."></textarea>
      </div>
      <div class="border-t border-maye-border p-5 sm:p-6 flex items-center justify-between gap-3">
        <button id="btnPrevSection"
          class="px-5 py-2.5 rounded-maye-md bg-maye-muted hover:bg-maye-border text-maye-text-base font-semibold transition disabled:opacity-40">
          ← Inyuma
        </button>
        <div class="flex items-center gap-2">
          <span id="saveHint" class="text-xs text-maye-text-muted hidden sm:inline">💾 Draft ibikwa bwite</span>
          <button id="btnNextSection"
            class="px-6 py-2.5 rounded-maye-md bg-maye-primary hover:bg-maye-primary-600 text-white font-bold shadow-maye-md transition">
            Komeza →
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SCREEN: REVIEW ============ -->
  <section id="screenReview" class="screen">
    <div class="bg-maye-surface rounded-maye-lg shadow-maye-md border border-maye-border fade-in">
      <div class="border-b border-maye-border p-5 sm:p-6">
        <h2 class="text-xl sm:text-2xl font-bold text-maye-text-strong">📋 Reba ibisubizo byawe</h2>
        <p class="text-sm text-maye-text-muted mt-1">Reba neza mbere yo kohereza. Ushobora guhindura igice icyo ari cyo.</p>
      </div>
      <div id="reviewBody" class="p-5 sm:p-6 space-y-4"></div>
      <div class="border-t border-maye-border p-5 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-3">
        <button id="btnBackToEdit"
          class="w-full sm:w-auto px-5 py-2.5 rounded-maye-md bg-maye-muted hover:bg-maye-border text-maye-text-base font-semibold transition">
          ✏️ Hindura
        </button>
        <button id="btnSubmit"
          class="w-full sm:w-auto px-8 py-3 rounded-maye-md bg-maye-success hover:brightness-95 text-white font-bold shadow-maye-md transition">
          ✓ Ohereza ibisubizo
        </button>
      </div>
    </div>
  </section>

  <!-- ============ SCREEN: CONFIRMATION ============ -->
  <section id="screenConfirmation" class="screen">
    <div class="bg-maye-surface rounded-maye-lg shadow-maye-md border border-maye-border p-6 sm:p-10 text-center max-w-2xl mx-auto fade-in">
      <div class="mx-auto w-16 h-16 rounded-full bg-maye-success/15 flex items-center justify-center mb-4">
        <svg class="w-9 h-9 text-maye-success" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-maye-text-strong">🎉 Murakoze cyane!</h2>
      <p class="text-maye-text-base mt-2">Ibisubizo byanyu byoherejwe neza.</p>
      <div class="mt-5 inline-block bg-maye-muted border border-maye-border rounded-maye-md px-5 py-3">
        <div class="text-xs text-maye-text-muted font-semibold uppercase tracking-wide">Nimero y'ikiganiro</div>
        <div id="confirmationRef" class="text-lg font-bold text-maye-primary">INT-XXXXX</div>
      </div>
      <p id="syncNote" class="hidden text-sm text-maye-warning font-semibold mt-4"></p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
        <button id="btnNewInterview"
          class="px-6 py-3 rounded-maye-md bg-maye-primary hover:bg-maye-primary-600 text-white font-bold shadow-maye-md transition">
          + Tangira ikindi kiganiro
        </button>
      </div>
    </div>
  </section>

  <!-- ============ SCREEN: ADMIN GATE ============ -->
  <section id="screenAdminGate" class="screen">
    <div class="bg-maye-surface rounded-maye-lg shadow-maye-md border border-maye-border p-6 sm:p-8 max-w-2xl mx-auto fade-in">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-10 h-10 rounded-full bg-maye-primary/10 flex items-center justify-center">
          <span class="text-maye-primary font-bold">🔐</span>
        </div>
        <h2 class="text-2xl font-bold text-maye-text-strong">Admin Access</h2>
      </div>
      <p class="text-sm text-maye-text-muted mt-1 mb-5">Dashboard ya developer. Bisaba ko UID yawe iba muri Firebase allow-list.</p>

      <div class="bg-maye-muted border border-maye-border rounded-maye-md p-4">
        <div class="flex items-center justify-between gap-3">
          <div class="text-xs font-semibold text-maye-text-muted uppercase tracking-wide">UID yawe (anonymous)</div>
          <button id="btnToggleUid" class="text-xs font-bold text-maye-primary-400 hover:text-maye-primary-600 transition">👁 Erekana UID</button>
        </div>
        <div id="adminUid" class="mt-1 font-mono text-sm break-all text-maye-primary-600 font-semibold select-none blur-sm">—</div>
      </div>

      <div class="mt-5 space-y-2 text-sm text-maye-text-base leading-relaxed">
        <p class="font-bold text-maye-primary-600">📝 Uburyo bwo kwiyandikisha (rimwe gusa):</p>
        <ol class="list-decimal list-inside space-y-1.5 text-maye-text-base">
          <li>Koporora UID iri hejuru (kanda "Erekana UID" mbere).</li>
          <li>Jya muri <span class="font-semibold">Firebase Console → Realtime Database → Data</span>.</li>
          <li>Shyiramo <code class="bg-white border border-maye-border px-1.5 py-0.5 rounded text-xs font-mono">/systemSettings/interviewFlags/adminAllowList/{UID}</code> = <code class="bg-white border border-maye-border px-1.5 py-0.5 rounded text-xs font-mono">true</code></li>
          <li>Kanda <span class="font-semibold">Retry</span> hepfo.</li>
        </ol>
      </div>

      <div id="adminGateMsg" class="hidden mt-4 text-sm font-semibold rounded-maye-md px-4 py-2.5"></div>

      <div class="mt-6 flex flex-col sm:flex-row gap-3">
        <button id="btnAdminRetry"
          class="flex-1 px-6 py-3 rounded-maye-md bg-maye-primary hover:bg-maye-primary-600 text-white font-bold shadow-maye-md transition">
          🔄 Retry
        </button>
        <button id="btnAdminCancel"
          class="flex-1 px-6 py-3 rounded-maye-md bg-maye-muted hover:bg-maye-border text-maye-text-base font-semibold transition">
          ← Subira
        </button>
      </div>
    </div>
  </section>

  <!-- ============ SCREEN: DASHBOARD LIST ============ -->
  <section id="screenDashboard" class="screen">
    <div class="bg-maye-surface rounded-maye-lg shadow-maye-md border border-maye-border fade-in">
      <div class="border-b border-maye-border p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-maye-text-strong">📊 Dashboard</h2>
          <p class="text-sm text-maye-text-muted mt-1">Ibisubizo byose byakiriwe</p>
